# ==========================================
# GEMINI
# ==========================================

GEMINI_API_KEY=your_gemini_api_key_here

# Current Gemini model
GEMINI_MODEL=gemini-3.8-flash


# ==========================================
# TOKEN CONTROL
# ==========================================

# Approx. 2K-3K tokens depending on language.
# This protects the free-tier TPM budget.
AI_MAX_SOURCE_CHARS=9000

# Limit generated response size.
AI_MAX_OUTPUT_TOKENS=2048

# Retry only temporary errors.
AI_MAX_RETRIES=1

# API timeout
AI_TIMEOUT_SECONDS=60

# If Gemini fails / quota is reached,
# generate local fallback instead.
AI_FALLBACK_TO_DEMO=true


# ==========================================
# CORS
# ==========================================

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ==========================================
# FILE / INPUT LIMITS
# ==========================================

MAX_UPLOAD_MB=8
MAX_TEXT_CHARS=40000


# ==========================================
# APPLICATION RATE LIMIT
# ==========================================

RATE_LIMIT_PER_MINUTE=20
