# Google AI Studio API key. Keep this only on the backend/Render.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Conservative defaults for projects with a low TPM quota.
AI_MAX_SOURCE_CHARS=9000
AI_MAX_OUTPUT_TOKENS=1200
AI_ESTIMATED_TPM_BUDGET=6000
AI_MAX_RETRIES=0
AI_MIN_INTERVAL_SECONDS=8
AI_TIMEOUT_SECONDS=60
AI_FALLBACK_TO_DEMO=true

# Comma-separated exact frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_MB=8
MAX_TEXT_CHARS=40000
RATE_LIMIT_PER_MINUTE=12
